# Resume parsing runs locally without a provider key; JD Analytics requires OpenRouter.
# Select auto, off, openai, or openrouter.
LLM_PROVIDER=auto

# OpenRouter is used by JD Analytics and can also power resume extraction.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional alternative for resume extraction.
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4o-mini

# Add the exact deployed frontend origin when hosting the API remotely.
CORS_ORIGINS=
