{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RADIX Resume Parsing handoff to Profile Builder",
  "description": "Candidate profile with extracted skills and segmented experience, consumed by Profile Builder (Role 3).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_type",
    "source_file",
    "cv_file",
    "name",
    "email",
    "education",
    "projects",
    "hackathons",
    "internships",
    "certifications",
    "achievements",
    "preferred_roles",
    "skills",
    "extraction_mode"
  ],
  "properties": {
    "source_type": { "const": "resume" },
    "source_file": { "type": "string", "minLength": 1 },
    "cv_file": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "email": { "type": "string" },
    "education": {
      "type": "array",
      "items": { "type": "string" }
    },
    "projects": {
      "type": "array",
      "items": { "type": "string" }
    },
    "hackathons": {
      "type": "array",
      "items": { "type": "string" }
    },
    "internships": {
      "type": "array",
      "items": { "type": "string" }
    },
    "certifications": {
      "type": "array",
      "items": { "type": "string" }
    },
    "achievements": {
      "type": "array",
      "items": { "type": "string" }
    },
    "preferred_roles": {
      "type": "array",
      "items": { "type": "string" }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["skill_name", "category_code", "evidence", "confidence"],
        "properties": {
          "skill_name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "category_code": {
            "enum": [
              "COD",
              "DSA",
              "OOD",
              "APTI",
              "COMM",
              "AI",
              "CLOUD",
              "SQL",
              "SWE",
              "SYSD",
              "NETW",
              "OS",
              "OTHER"
            ]
          },
          "evidence": { "type": "string", "minLength": 1, "maxLength": 500 },
          "confidence": { "enum": ["high", "medium", "low"] }
        }
      }
    },
    "extraction_mode": { "type": "string" }
  }
}
