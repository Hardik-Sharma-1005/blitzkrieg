{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RADIX Talent Check request",
  "description": "Candidate profile plus explicit student ratings. Current sample benchmarks assess eleven categories; SQL and OTHER are not assessed yet.",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidate_profile", "company_name", "skill_ratings"],
  "properties": {
    "candidate_profile": {
      "$ref": "resume-parsing-output.schema.json"
    },
    "company_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "skill_ratings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["COD", "DSA", "OOD", "APTI", "COMM", "AI", "CLOUD", "SWE", "SYSD", "NETW", "OS"],
      "properties": {
        "COD": { "type": "integer", "minimum": 1, "maximum": 5 },
        "DSA": { "type": "integer", "minimum": 1, "maximum": 5 },
        "OOD": { "type": "integer", "minimum": 1, "maximum": 5 },
        "APTI": { "type": "integer", "minimum": 1, "maximum": 5 },
        "COMM": { "type": "integer", "minimum": 1, "maximum": 5 },
        "AI": { "type": "integer", "minimum": 1, "maximum": 5 },
        "CLOUD": { "type": "integer", "minimum": 1, "maximum": 5 },
        "SQL": { "type": "integer", "minimum": 1, "maximum": 5 },
        "SWE": { "type": "integer", "minimum": 1, "maximum": 5 },
        "SYSD": { "type": "integer", "minimum": 1, "maximum": 5 },
        "NETW": { "type": "integer", "minimum": 1, "maximum": 5 },
        "OS": { "type": "integer", "minimum": 1, "maximum": 5 },
        "OTHER": { "type": "integer", "minimum": 1, "maximum": 5 }
      }
    }
  }
}
