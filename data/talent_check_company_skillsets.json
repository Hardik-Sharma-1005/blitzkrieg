      "label": "Awareness",
      "description": "Can recognize core concepts and explain basic terminology; needs guidance."
    },
    "2": {
      "label": "Foundational",
      "description": "Can handle simple, well-scoped tasks with support."
    },
    "3": {
      "label": "Working",
      "description": "Can independently perform common role-relevant tasks."
    },
    "4": {
      "label": "Advanced",
      "description": "Can handle complex tasks, troubleshoot issues, and choose effective approaches."
    },
    "5": {
      "label": "Expert",
      "description": "Can lead complex work, make high-impact decisions, and guide others."
    }
  },
  "importance_weight_scale": {
    "1": {
      "label": "Peripheral",
      "description": "A supplementary signal mentioned briefly or as a minor advantage."
    },
    "2": {
      "label": "Useful",
      "description": "Helpful to performance but limited in scope or frequency."
    },
    "3": {
      "label": "Relevant",
      "description": "Meaningful to recurring responsibilities in the role."
    },
    "4": {
      "label": "Important",
      "description": "Strongly connected to several core responsibilities."
    },
    "5": {
      "label": "Core",
      "description": "Explicitly essential or central to the main responsibilities."
    }
  },
